<%- include("partials/header") %>

<main class="catalog-page">
  <h1>Fragrance Catalog</h1>
  <p>Discover and explore your favorite fragrances.</p>

  <form action="/catalog" method="GET" class="filter-form">

    <input
      type="text"
      name="search"
      placeholder="Search fragrances..."
      value="<%= search %>"
    >

    <select name="brand" id="brand">
      <option value="">All Brands</option>

      <% brands.forEach(brand => { %>
        <option
          value="<%= brand.brandID %>"
          <%= String(selectedBrand) === String(brand.brandID)
            ? "selected" : "" %>
        >
          <%= brand.name %>
        </option>
      <% }) %>
    </select>

    <button type="submit">Search</button>
  </form>

  <p><%= fragrances.length %> fragrances found</p>

  <div class="fragrance-grid">
    <% fragrances.forEach(fragrance => { %>
      <div class="fragrance-card">

        <h2><%= fragrance.name %></h2>

        <p><strong>Brand:</strong> <%= fragrance.brand %></p>

        <p>
          <strong>Concentration:</strong>
          <%= fragrance.concentration %>
        </p>

        <p>
          <strong>Notes:</strong>
          <%= fragrance.notes.join(", ") %>
        </p>

        <a
          href="/fragrance/<%= encodeURIComponent(fragrance.fragranceID) %>"
          class="details-button"
        >
          View Details
        </a>

      </div>
    <% }) %>
  </div>

  <% if (fragrances.length === 0) { %>
    <p>No fragrances match your search.</p>
  <% } %>
</main>

<%- include("partials/footer") %>